#!/usr/bin/env python3
"""Emit each crate module's public signatures as a digest, plus a routing index.

Usage: tools/apidoc [outdir]   (default docs/api)
"""
import re, sys, pathlib, shutil

REPO = pathlib.Path(__file__).resolve().parent.parent
SKIP = {"target", "shaders"}


def collapse(s):
    s = re.sub(r"\s+", " ", s).strip()
    return re.sub(r",?\s*\)", ")", s.replace("( ", "("))


def signatures(path):
    lines = path.read_text().splitlines()
    out, ctx, i, n, names, fns = [], None, 0, len(lines), [], []
    while i < n:
        raw, s = lines[i], lines[i].strip()

        if s.startswith("#[cfg(test)]"):
            depth, i = 0, i + 1
            while i < n:
                depth += lines[i].count("{") - lines[i].count("}")
                i += 1
                if depth <= 0:
                    break
            continue

        m = re.match(r"^impl(?:<[^>]*>)?\s+(.*?)(?:\s*\{)?$", s)
        if s.startswith("impl") and m:
            head = m.group(1).rstrip(" {")
            if " for " in head:
                out.append((0, f"impl {head}"))
                ctx = None
            else:
                ctx = f"impl {head}"
                out.append((0, ctx))
            i += 1
            continue

        if s.startswith("pub use "):
            out.append((0, s.rstrip(";") + ";"))
            i += 1
            continue

        if re.match(r"^pub (struct|enum|trait|type|const|static)\b", s):
            head, j = s, i
            while not re.search(r"[;{]\s*$", head) and j + 1 < n:
                j += 1
                head += " " + lines[j].strip()
            decl = collapse(head.rstrip("{").rstrip())
            out.append((0, decl))
            if (t := re.search(r"\b(?:struct|enum|trait|type) (\w+)", decl)):
                names.append(t.group(1))
            if head.rstrip().endswith("{"):
                k, body = j + 1, []
                while k < n and lines[k].strip() != "}":
                    b = lines[k].strip()
                    if b.startswith("pub ") or re.match(r"^[A-Z]\w*", b):
                        body.append(b.rstrip(","))
                    k += 1
                if body:
                    out.append((1, ", ".join(body)))
                j = k
            ctx, i = None, j + 1
            continue

        if s.startswith("handle!") or s.startswith("macro_rules!"):
            j, body = i, []
            while j < n and (j == i or lines[j].strip() != "}"):
                j += 1
                if j < n and not lines[j].strip().startswith("//"):
                    body.append(lines[j].strip())
            if s.startswith("handle!"):
                inner = collapse(" ".join(body[:-1]))
                out.append((0, f"handle! {{ {inner} }}"))
                names += [w for w in re.findall(r"\w+", inner)]
            i = j + 1
            continue

        if re.match(r"^pub (async )?(unsafe )?fn\b", s):
            sig, j = s, i
            while not (sig.count("(") == sig.count(")")
                       and re.search(r"[;{]\s*$", sig)) and j + 1 < n:
                j += 1
                sig += " " + lines[j].strip()
            sig = re.sub(r"\s*\{\s*$", "", collapse(sig)).rstrip(";")
            out.append((1 if ctx else 0, sig))
            fns.append(re.search(r"fn (\w+)", sig).group(1))
            i = j + 1
            continue
        i += 1

    body = "\n".join(("  " if d else "") + t for d, t in out)
    return body, names, fns


def render(paths, title, depth):
    chunks, names, fns = [], [], []
    for p in sorted(paths):
        body, ns, fs = signatures(p)
        names += ns
        fns += fs
        if body.strip():
            chunks.append(f"### {p.relative_to(REPO)}\n\n```rust\n{body}\n```\n")
    if not chunks:
        return None, [], []
    header = (f"# {title}\n\n"
              "Generated by `make api` — signatures only. Read the source of the\n"
              "one item you are changing, not the module to find out what exists.\n"
              f"[index]({'../' * depth}index.md)\n\n")
    return header + "\n".join(chunks), sorted(set(names)), sorted(set(fns))


def symcol(names, fns, limit):
    syms = names + [f"{f}()" for f in fns if f not in ("new", "default")]
    shown = ", ".join(f"`{s}`" for s in syms[:limit]) or "—"
    return shown + (f", +{len(syms) - limit} more" if len(syms) > limit else "")


def write_index(path, title, blurb, rows, depth, fns_in_col=True):
    lines = [f"# {title}", "", blurb, "",
             "| Module | Digest | ~tok | Public symbols |", "|---|---|---|---|"]
    for name, rel, tok, names, fns in rows:
        cols = symcol(names, fns if fns_in_col else [], 24 if fns_in_col else 14)
        lines.append(f"| `{name}` | [{rel}]({rel}) | {tok} | {cols} |")
    if depth:
        lines += ["", f"[engine index]({'../' * depth}index.md)"]
    path.write_text("\n".join(lines) + "\n")


SPLIT_TOK = 2200


def units():
    for crate in sorted((REPO / "crates").iterdir()):
        src = crate / "src"
        if not src.is_dir():
            continue
        cname = crate.name
        loose = [p for p in src.glob("*.rs")]
        for d in sorted(p for p in src.iterdir() if p.is_dir() and p.name not in SKIP):
            yield f"{cname}/{d.name}", f"{cname}::{d.name}", sorted(d.rglob("*.rs"))
        if len(loose) > 6:
            for p in sorted(loose):
                yield f"{cname}/{p.stem}", f"{cname}::{p.stem}", [p]
        elif loose:
            yield cname, cname, sorted(loose)


def emit(out, slug, title, paths):
    """Write one unit; split it into a sub-index when it is too big to load whole."""
    depth = slug.count("/")
    text, names, fns = render(paths, title, depth)
    if not text:
        return None
    tok = len(text) // 4
    if tok <= SPLIT_TOK or len(paths) < 2:
        f = out / f"{slug}.md"
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text)
        return title, f"{slug}.md", tok, names, fns

    sub, rows = out / slug, []
    sub.mkdir(parents=True, exist_ok=True)
    for p in sorted(paths):
        body, ns, fs = render([p], f"{title}::{p.stem}", depth + 1)
        if not body:
            continue
        (sub / f"{p.stem}.md").write_text(body)
        rows.append((f"{title}::{p.stem}", f"{p.stem}.md", len(body) // 4, ns, fs))
    write_index(sub / "index.md", title,
                f"`{title}` is ~{tok} tokens of signatures — too many to load whole.\n"
                "Each file below is one part of it; open only the ones you need.",
                rows, depth + 1)
    idx_tok = len((sub / "index.md").read_text()) // 4
    return title, f"{slug}/index.md", idx_tok, names, fns


def main():
    out = REPO / (sys.argv[1] if len(sys.argv) > 1 else "docs/api")
    if out.exists():
        shutil.rmtree(out)
    rows, total = [], 0
    for slug, title, paths in units():
        r = emit(out, slug, title, paths)
        if r:
            rows.append(r)
            total += r[2]
    write_index(
        out / "index.md", "Engine API index",
        "Every public signature in `crates/`, generated by `make api`. Regenerate\n"
        "after changing a public item, or let the pre-commit hook do it for you.\n\n"
        f"This index plus every module digest is ~{total // 1000}k tokens against ~380k\n"
        "of source. **Load the one module you need** — find a symbol below, open that\n"
        "file, and read the crate source only for the item you are actually changing.\n"
        "A row pointing at an `index.md` is a module split further; that index routes\n"
        "inside it.", rows, 0, fns_in_col=False)
    print(f"{len(rows)} modules, ~{total} tokens -> {out.relative_to(REPO)}")


main()
